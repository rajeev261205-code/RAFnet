# --- Frontend (Vite + React, public vars only: VITE_ prefix) ---
# VITE_API_URL: backend base URL, no trailing slash. An https:// value maps to
# wss:// automatically for the live stream when VITE_WS_URL is left empty.
VITE_API_URL=http://localhost:8000
# VITE_WS_URL: explicit WebSocket URL for /ws/live (optional). If empty, it is
# derived from VITE_API_URL (https -> wss, http -> ws).
# Production example: wss://<api-host>/ws/live
VITE_WS_URL=ws://localhost:8000/ws/live
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: email auth (optional). Leave empty
# for labeled DEV MODE login. NEVER put a service_role key here (anon key only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
